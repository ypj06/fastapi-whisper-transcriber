# 复制为 .env 后按需修改；不提交到 Git
# cp .env.example .env

# ---------- 模型 ----------
# 模型缓存目录（默认 <项目根>/models）
WHISPER_MODEL_DIR=./models
# 指定本地已有的模型目录，优先级高于在线下载
# WHISPER_LOCAL_PATH=D:/models/faster-whisper-medium
# 启动时加载的模型编号 1~7（1=tiny … 7=large-v3）
WHISPER_MODEL_CHOICE=2
# 强制推理设备与精度，留空表示自动检测（有 CUDA 用 float16，否则 CPU + int8）
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# 国内下载模型慢时可用镜像
# HF_ENDPOINT=https://hf-mirror.com

# ---------- 翻译（可选）----------
# 未填写时翻译接口直接返回原文
BAIDU_APP_ID=
BAIDU_APP_KEY=

# ---------- 服务 ----------
PORT=8000
LOG_LEVEL=INFO
# 上传大小上限（MB）
MAX_UPLOAD_MB=500
# 允许的跨域来源，逗号分隔
CORS_ORIGINS=*
